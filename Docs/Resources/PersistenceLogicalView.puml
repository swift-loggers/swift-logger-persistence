@startuml

title swift-logger-persistence logical view (non-normative)

skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 38
skinparam ranksep 42
skinparam ArrowColor #475569
skinparam ArrowFontColor #334155
skinparam ArrowThickness 1
skinparam rectangle {
  BorderColor #334155
  FontColor #0F172A
  RoundCorner 8
}
top to bottom direction

rectangle "Logger adapter\n(upstream; out of scope)" as Adapter #F8FAFC
rectangle "LogRecordPersistentEncoder\nredaction + producer sequence" as Encoder #F8FAFC
rectangle "PersistentLogEnvelope\npackage-owned write unit" as Envelope #F8FAFC
rectangle "PersistentLogStore\n<<protocol>>\nappend / flush" as Store #EFF6FF
rectangle "FileLogStore\nfile-backed local persistence" as FileStore #ECFDF5

rectangle "ExportableLogStore\noptional file-store protocol" as Exportable #FFF7ED
rectangle "Byte-stable export\nexportLogs(to:)" as Export #FFF7ED
rectangle "Destructive removal\nremoveExportedLogs()" as Remove #FFF7ED
rectangle "File-store retention policy\noptional lifecycle surface\ncount, byte, age (shipped)" as Retention #FFF7ED

rectangle "FileFormatSpec.md\nnormative contract owner\naccepted bytes\naccepted ordering\nrecoverable visibility" as Format #F5F3FF
rectangle "APIDesign.md\nAPI-observable contract owner" as API #F5F3FF
rectangle "APICompatibility.md\npublic diagnostics evolution" as Compatibility #F5F3FF

Adapter -down-> Encoder
Encoder -down-> Envelope
Envelope -down-> Store
Store -down-> FileStore

FileStore -right-> Exportable
FileStore -right-> Retention
Exportable -[hidden]down-> Retention
Exportable -down-> Export
Export -down-> Remove

FileStore -right-> Format
Exportable -right-> API
API -down-> Compatibility
Format -[hidden]down-> API

@enduml
